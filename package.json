{
  "name": "deniz-agent-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "deniz-skills": "dist/install-opencode.js"
  },
  "files": [
    "dist",
    "opencode"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build.ts && tsc -p tsconfig.installer.json && biome format --write dist",
    "inventory": "node tools/inventory.ts",
    "eject": "node tools/eject.ts",
    "sync": "node tools/sync.ts",
    "validate": "node tools/validate.ts",
    "install:opencode": "node tools/install-opencode.ts",
    "pretest": "node tools/check-test-discovery.ts",
    "test": "node --test \"tools/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
