{
  "name": "deniz-agent-skills",
  "version": "0.2.0",
  "description": "Personal, opinionated Claude Code Plugins and OpenCode Module Bundles",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Deniz İrgin",
    "email": "1965259+Blind-Striker@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blind-Striker/agent-skills-and-plugins.git"
  },
  "homepage": "https://github.com/Blind-Striker/agent-skills-and-plugins#readme",
  "bugs": {
    "url": "https://github.com/Blind-Striker/agent-skills-and-plugins/issues"
  },
  "type": "module",
  "bin": {
    "deniz-skills": "dist/install-opencode.js"
  },
  "files": [
    "dist",
    "opencode",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build.ts && tsc -p tsconfig.installer.json && biome format --write dist",
    "inventory": "node tools/inventory.ts",
    "eject": "node tools/eject.ts",
    "sync": "node tools/sync.ts",
    "validate": "node tools/validate.ts",
    "check:public-safety": "node tools/check-public-safety.ts",
    "install:opencode": "node tools/install-opencode.ts",
    "pretest": "node tools/check-test-discovery.ts",
    "test": "node --test \"tools/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "yaml": "^2.6.0"
  }
}
