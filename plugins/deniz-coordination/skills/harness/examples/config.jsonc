// Example user config. Copy it to the user config folder as config.jsonc and edit it there.
// DISPATCH_HOME uses config/config.jsonc beneath that folder instead of the OS config folder.
// A repository may add .dispatch/config.jsonc. Later preferences win; restrictions accumulate.
{
  "schemaVersion": 2,
  "preferences": {
    "backend": "codex",
    "maxParallel": 3
  },
  "restrictions": {
    // Leave routes absent for no list from this layer. An empty array allows nothing.
    // User and repository lists intersect. With neither list there is no route restriction,
    // but every task still names a route; no default model ever runs.
    // "routes": ["codex:<model>#<effort>", "opencode:<provider>/<model>#<variant>"]
  }
  // User layer only; use absolute paths, or ~ for locations. Add a comma above to enable:
  // "locations": { "worktreeRoot": "<short absolute folder>", "ledgerRoot": "<absolute folder>" },
  // "backends": { "opencode": { "executable": "<absolute path>", "env": [] }, "codex": { "env": [] } }
}
